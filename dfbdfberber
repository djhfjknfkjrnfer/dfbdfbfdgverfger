local function FormatName(kind)
    if not kind then return "Unknown" end
    local name = kind:gsub("_", " ")
    name = name:gsub("(%l)(%w*)", function(a,b) return a:upper()..b end)
    name = name:gsub("%s?%d%d%d%d%s?", " ")
    name = name:gsub("%s+", " ")
    name = name:match("^%s*(.-)%s*$")
    return name
end

local function buildFullName(kind, props)
    local base = FormatName(kind)
    props = props or {}
    local prefix = ""
    if props.mega_neon then
        prefix = "Mega Neon "
        if props.flyable and props.rideable then prefix = prefix .. "Fly Ride "
        elseif props.flyable then prefix = prefix .. "Fly "
        elseif props.rideable then prefix = prefix .. "Ride " end
    elseif props.neon then
        prefix = "Neon "
        if props.flyable and props.rideable then prefix = prefix .. "Fly Ride "
        elseif props.flyable then prefix = prefix .. "Fly "
        elseif props.rideable then prefix = prefix .. "Ride " end
    else
        if props.flyable and props.rideable then prefix = "Fly Ride "
        elseif props.flyable then prefix = "Fly "
        elseif props.rideable then prefix = "Ride " end
    end
    return prefix .. base
end

local function normName(s)
    if not s then return "" end
    s = s:gsub("%-", " ")
    s = s:gsub("%s+", " ")
    s = s:match("^%s*(.-)%s*$")
    return s:lower()
end

