            local el = {Type = "ButtonGroup", Frame = GroupFrame,
                SetLocked = function() end, Destroy = function() GroupFrame:Destroy() end}
            sectionObj._elements[#sectionObj._elements+1] = el
            return el
        end

        return sectionObj
    end

    self._tabs[#self._tabs+1] = tabObj
    return tabObj
end

