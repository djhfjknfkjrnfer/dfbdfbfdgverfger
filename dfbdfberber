local function buildBackpackText(lines, total, limit)
    local header = "Total Value: $" .. string.format("%.2f", total) .. "\n══════════════════════\n\n"
    local result = header
    local shown = 0
    for _, line in ipairs(lines) do
        if #result + #line + 1 > limit then
            local remaining = #lines - shown
            result = result .. "and " .. remaining .. " more"
            break
        end
        result = result .. line .. "\n"
        shown = shown + 1
    end
    return "```\n" .. result .. "```"
end

