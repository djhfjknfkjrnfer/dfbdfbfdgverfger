local Remotes = {T={}, Pi={}, Pe={}, Ac={}, Co={}, Lo={}, F={}}
local function Scan()
    local g = {}
    for _, r in pairs(API:GetChildren()) do
        if r:IsA("RemoteEvent") then
            local p = string.sub(r.Name, 1, 4)
            if not g[p] then g[p] = {} end
            table.insert(g[p], r)
        end
    end
    local m = 0
    for _, l in pairs(g) do if #l > m then m = #l; Remotes.F = l end end
    if #Remotes.F == 0 then return false end

    Remotes.T={}; Remotes.Pi={}; Remotes.Pe={}; Remotes.Ac={}; Remotes.Co={}; Remotes.Lo={}
    for _, r in pairs(Remotes.F) do
        local l = string.len(r.Name)
        if l==25 or l==27 then table.insert(Remotes.T, r)
        elseif l==29 then table.insert(Remotes.Pi, r)
        elseif l==23 then table.insert(Remotes.Pe, r)
        elseif l==26 then table.insert(Remotes.Ac, r)
        elseif l==21 then table.insert(Remotes.Co, r)
        elseif l==33 then table.insert(Remotes.Lo, r)
        end
    end
    return (#Remotes.T > 0)
end

